cabal-version: 3.0
name:          treasury-workers
version:       0.1.0.0
synopsis:      Background workers and cron jobs that drive the payment lifecycle
license:       NONE
build-type:    Simple

common shared
    default-language: GHC2021
    default-extensions:
        DataKinds
        NumericUnderscores
        DeriveAnyClass
        DerivingStrategies
        DuplicateRecordFields
        LambdaCase
        MultiWayIf
        NoFieldSelectors
        OverloadedRecordDot
        OverloadedStrings
        RecordWildCards
        StrictData
        TypeFamilies
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields -Wredundant-constraints -Werror

library
    import: shared
    hs-source-dirs: src
    exposed-modules:
        Treasury.Workers.Poll
        Treasury.Workers.Reconcile
        Treasury.Workers.Submit
        Treasury.Workers.Shared
    build-depends:
        base >=4.18 && <5,
        aeson,
        containers,
        esqueleto,
        exceptions,
        http-client,
        monad-logger,
        persistent,
        persistent-postgresql,
        text,
        time,
        unliftio,
        treasury-core,
        treasury-partner-client

executable treasury-workers
    import: shared
    hs-source-dirs: app
    main-is: Main.hs
    ghc-options: -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base,
        optparse-applicative,
        treasury-core,
        treasury-workers
