#!/usr/bin/env bash
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit
if ! command -v pg-stop >/dev/null 2>&1; then
  exec nix develop -c "$0" "$@"
fi

for f in .pg/logs/*.pid; do
  [ -f "$f" ] || continue
  name=$(basename "$f" .pid)
  pid=$(cat "$f")
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null && echo "stopped $name"
  else
    echo "$name was not running"
  fi
  rm -f "$f"
done
pg-stop 2>/dev/null || true
